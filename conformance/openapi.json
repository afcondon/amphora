{
  "openapi": "3.0.3",
  "info": {
    "title": "Amphora",
    "version": "1",
    "description": "The Atlantis artefact store: immutable content named by the hash of its payload, with labels, favourites, morphisms and refs. Generated from Amphora.Api; see conformance/AMPHORA-API.md."
  },
  "servers": [
    {
      "url": "http://localhost:3024"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Whether the store is up.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "the text `ok`",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/content": {
      "post": {
        "operationId": "putContent",
        "summary": "Save content. The same payload twice is saved once.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "content to save",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hash": {
                      "type": "string"
                    },
                    "deduped": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "hash",
                    "deduped"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "the body is not content to save",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listContent",
        "summary": "Every piece of content, or every one of a kind, without payloads.",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "only content of this kind",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array of content without its payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "hash": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string",
                        "nullable": true
                      }
                    },
                    "required": [
                      "hash",
                      "kind",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/content/{hash}": {
      "get": {
        "operationId": "getContent",
        "summary": "One piece of content, by its hash.",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "description": "the content's hash",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hash": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "payload": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "hash",
                    "kind",
                    "payload",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "no content has that hash",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/labels": {
      "post": {
        "operationId": "addLabel",
        "summary": "Give content a name. Content may have many.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "label to add",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "contentHash": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "harmonicRoot": {
                    "type": "string"
                  },
                  "harmonicScale": {
                    "type": "string"
                  },
                  "harmonicChord": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "contentHash",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the new label's identifier",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "the body is not a label to add",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "the label could not be written",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listLabels",
        "summary": "Every label, or every label of one piece of content.",
        "parameters": [
          {
            "name": "hash",
            "in": "query",
            "required": false,
            "description": "only labels of this content",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array of label",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "contentHash": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "nullable": true
                      },
                      "harmonicRoot": {
                        "type": "string",
                        "nullable": true
                      },
                      "harmonicScale": {
                        "type": "string",
                        "nullable": true
                      },
                      "harmonicChord": {
                        "type": "string",
                        "nullable": true
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "createdAt": {
                        "type": "string",
                        "nullable": true
                      }
                    },
                    "required": [
                      "id",
                      "contentHash",
                      "name",
                      "source",
                      "harmonicRoot",
                      "harmonicScale",
                      "harmonicChord",
                      "tags",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/morphisms": {
      "post": {
        "operationId": "addMorphism",
        "summary": "Record that one piece of content was made from another.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "morphism to add",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "params": {}
                },
                "required": [
                  "from",
                  "to",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{\"ok\": true}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "the body is not a morphism to add",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listMorphisms",
        "summary": "Morphisms, all or those from or to given content.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "only those starting here",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "only those arriving here",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array of morphism",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "params": {
                        "type": "string",
                        "nullable": true
                      }
                    },
                    "required": [
                      "from",
                      "to",
                      "kind",
                      "params"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/favorites": {
      "post": {
        "operationId": "addFavorite",
        "summary": "Publish content in a collection.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "favourite",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "contentHash": {
                    "type": "string"
                  },
                  "collection": {
                    "type": "string"
                  }
                },
                "required": [
                  "contentHash",
                  "collection"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{\"ok\": true}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "the body is not a favourite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listFavorites",
        "summary": "What is published, in every collection or in one.",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "description": "only this collection",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array of favourite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "contentHash": {
                        "type": "string"
                      },
                      "collection": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "contentHash",
                      "collection"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "removeFavorite",
        "summary": "Take content out of a collection. The content and its labels stay.",
        "parameters": [
          {
            "name": "hash",
            "in": "query",
            "required": true,
            "description": "the content",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "query",
            "required": true,
            "description": "the collection",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{\"ok\": true}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "the hash or the collection was not given",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/refs": {
      "get": {
        "operationId": "listRefs",
        "summary": "Every ref, or every ref whose name starts with a prefix.",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "description": "only refs whose names start so",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array of ref",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "hash": {
                        "type": "string"
                      },
                      "movedAt": {
                        "type": "string",
                        "nullable": true
                      }
                    },
                    "required": [
                      "name",
                      "hash",
                      "movedAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/refs/{name}": {
      "get": {
        "operationId": "getRef",
        "summary": "Where a ref points.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "the ref's name (takes every remaining segment of the path: it may contain `/`, which is not to be percent-encoded)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ref",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "hash": {
                      "type": "string"
                    },
                    "movedAt": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "name",
                    "hash",
                    "movedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "there is no such ref",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "moveRef",
        "summary": "Point a ref at content, if it still points where the writer expects.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "the ref's name (takes every remaining segment of the path: it may contain `/`, which is not to be percent-encoded)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "where to move the ref",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string"
                  }
                },
                "required": [
                  "to"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ref",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "hash": {
                      "type": "string"
                    },
                    "movedAt": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "name",
                    "hash",
                    "movedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "the body does not say where to move the ref",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "no content has the hash to move to",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "the ref did not point where the writer expected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "current": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "hash": {
                          "type": "string"
                        },
                        "movedAt": {
                          "type": "string",
                          "nullable": true
                        }
                      },
                      "required": [
                        "name",
                        "hash",
                        "movedAt"
                      ],
                      "additionalProperties": false,
                      "nullable": true
                    }
                  },
                  "required": [
                    "error",
                    "current"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/moves": {
      "get": {
        "operationId": "listMoves",
        "summary": "Everywhere a ref has pointed, oldest first.",
        "parameters": [
          {
            "name": "ref",
            "in": "query",
            "required": true,
            "description": "the ref's name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array of one move of a ref",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "from": {
                        "type": "string",
                        "nullable": true
                      },
                      "to": {
                        "type": "string"
                      },
                      "movedAt": {
                        "type": "string",
                        "nullable": true
                      }
                    },
                    "required": [
                      "name",
                      "from",
                      "to",
                      "movedAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "the ref was not given",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
